<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= chat.title %> — Shared Chat</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #1a1a1a; color: #eee; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .shared-header { background: #222; border-bottom: 1px solid #333; padding: 16px 24px; text-align: center; }
    .shared-header h1 { font-size: 18px; font-weight: 600; }
    .shared-header p { font-size: 12px; color: #888; margin-top: 4px; }
    .shared-badge { display: inline-block; background: rgba(139,139,255,0.15); color: #8b8bff; font-size: 11px; padding: 2px 8px; border-radius: 10px; margin-top: 6px; }
    .messages-container { max-width: 720px; margin: 0 auto; padding: 24px 16px; }
    .message { margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; max-width: 85%; }
    .message.user { background: #2a2a3a; margin-left: auto; border-bottom-right-radius: 4px; }
    .message.assistant, .message.bot { background: #2a2a2a; margin-right: auto; border-bottom-left-radius: 4px; }
    .message-role { font-size: 11px; font-weight: 600; color: #8b8bff; margin-bottom: 4px; text-transform: uppercase; }
    .message-content { font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word; }
    .message-time { font-size: 11px; color: #666; margin-top: 4px; }
    .footer { text-align: center; padding: 24px; color: #666; font-size: 12px; }
    .footer a { color: #8b8bff; text-decoration: none; }
    .footer a:hover { text-decoration: underline; }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
  </style>
</head>
<body>
  <div class="shared-header">
    <h1><%= chat.title %></h1>
    <p>Shared on <%= new Date().toLocaleDateString() %></p>
    <span class="shared-badge">Read-only</span>
  </div>

  <div class="messages-container">
    <% messages.forEach(function(msg) { %>
      <div class="message <%= msg.role === 'user' ? 'user' : 'bot' %>">
        <div class="message-role"><%= msg.role === 'user' ? 'You' : 'AI' %></div>
        <div class="message-content"><%= msg.content %></div>
        <% if (msg.timestamp) { %>
          <div class="message-time"><%= new Date(msg.timestamp).toLocaleString() %></div>
        <% } %>
      </div>
    <% }); %>
  </div>

  <div class="footer">
    Shared via <a href="/">Q-Dev-AI</a>
  </div>
</body>
</html>
