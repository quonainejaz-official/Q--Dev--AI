# ---- Core ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
MAX_MESSAGE_LENGTH=50000
MAX_HISTORY_LENGTH=20

# ---- Model provider ----
OPENCODE_API_KEY=your_opencode_api_key

# ---- Auth / Accounts (optional: without these the app runs in guest-only mode) ----
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/qdevai?retryWrites=true&w=majority
# Secret used to sign login JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth Client ID (from Google Cloud Console -> Credentials -> OAuth client, type: Web)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- Cloudinary (optional: for storing uploaded/generated images) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
